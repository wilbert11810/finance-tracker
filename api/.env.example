# Environment variables the API expects (read via getenv()).
# Local development: these are set in docker-compose.yml.
# Production (Render): set them in the service's environment settings.
# Never commit real credentials.

DB_HOST=localhost
DB_PORT=3306
DB_USER=finance_app
DB_PASSWORD=change-me
DB_NAME=finance_tracker

# Production only: the database CA certificate contents, which enables TLS.
# DB_SSL_CA_PEM=
